[Unit]
Description=vinoWatch tray: CPU, RAM and NPU use of OpenVINO apps
Documentation=https://github.com/karanshukla/vinoWatch
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/vinowatch
Restart=on-failure
RestartSec=2
# Needs the user's own /proc and the session bus. The only things it runs are
# the stuck-driver probe (a Python with openvino) and `systemctl start
# vino-npu-reset.service`, both from the tray menu; Unix sockets cover the
# system bus that takes.
# No ProtectKernelModules= or ProtectKernelLogs=: in a user unit they make
# systemd 255 (Ubuntu 24.04) drop capabilities it doesn't have, and the tray
# never starts (status 218/CAPABILITIES). An unprivileged process can't load
# modules anyway.
# No ProtectSystem=, ProtectHome= or ProtectControlGroups= either: a user
# manager can only set up their mount namespace inside a user namespace, and
# from there another process's /proc/<pid>/maps, smaps_rollup and fd/ are
# permission denied, so detection, PSS and "NPU open" all silently degrade.
NoNewPrivileges=yes
UMask=0077
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=graphical-session.target
